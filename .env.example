# =============================================================================
# FinFlow - Vercel Serverless & Supabase Cloud Environment Variables
# =============================================================================

# 1. Supabase PostgreSQL Cloud Database Connection String
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI / Nodejs)
# Example format:
# postgresql://postgres.yourprojectref:YourPassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# 2. Secret key used for cryptographic JWT signing
JWT_SECRET=finflow-production-jwt-secret-key-change-this-in-production-2026
